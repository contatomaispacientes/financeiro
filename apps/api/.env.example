NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
APP_TIMEZONE=America/Sao_Paulo

# Database
DATABASE_URL=postgresql://financeiro:financeiro@localhost:5432/financeiro

# Redis
REDIS_URL=redis://localhost:6379

# JWT (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Asaas (mock = simulado, sem conta: ADR-016)
ASAAS_ENV=sandbox
ASAAS_API_KEY=$aact_sandbox_key_here
ASAAS_WEBHOOK_TOKEN=change-me-webhook-token-at-least-32-chars
ASAAS_MIN_CHARGE_CENTS=500

# Contracts
CONTRACT_PROVIDER=fake
CLICKSIGN_ENV=sandbox
# CLICKSIGN_ACCESS_TOKEN=
# CLICKSIGN_HMAC_SECRET=
# FAKE_CONTRACT_WEBHOOK_SECRET=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# Mail (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=financeiro@local.test

# Seed
SEED_ADMIN_PASSWORD=admin12345678
