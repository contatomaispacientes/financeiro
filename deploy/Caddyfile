# DOMAIN vem do .env (ex.: financeiro.suaempresa.com.br). O Caddy emite e renova o HTTPS sozinho.
{$DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	header Strict-Transport-Security "max-age=31536000"
}
