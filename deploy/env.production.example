# Copie para .env na raiz do projeto na VPS:  cp deploy/env.production.example .env
# Gere cada segredo com:  openssl rand -hex 32
# Este arquivo já vem no MODO DEMONSTRAÇÃO (Asaas e contratos simulados, nada é cobrado).
# Para cobrar de verdade, siga o "Checklist de virada" em docs/deploy.md.

# Subdomínio apontado para o IP da VPS (registro A)
DOMAIN=financeiro.suaempresa.com.br

# Banco (só letras e números: entra na URL de conexão)
POSTGRES_PASSWORD=troque-por-openssl-rand-hex-32

APP_TIMEZONE=America/Sao_Paulo
JWT_ACCESS_SECRET=troque-por-openssl-rand-hex-32
JWT_REFRESH_SECRET=troque-por-outro-openssl-rand-hex-32

# ── Asaas ──────────────────────────────────────────────
# mock = simulado dentro do sistema (ADR-016): cobranças, Pix, fatura e "Simular pagamento", sem conta no Asaas.
# sandbox = conta de testes do Asaas; production = cobrança real.
ASAAS_ENV=mock
# Entre aspas simples: a chave começa com $ e o Docker tentaria expandir. Vazia no modo mock.
ASAAS_API_KEY=''
ASAAS_WEBHOOK_TOKEN=troque-por-openssl-rand-hex-32
ASAAS_MIN_CHARGE_CENTS=500

# ── Contratos ──────────────────────────────────────────
# fake = assinatura simulada (página "Abrir" em cada signatário). clicksign só depois das tarefas 12–13 da spec 07.
CONTRACT_PROVIDER=fake
CLICKSIGN_ENV=sandbox
# CLICKSIGN_ACCESS_TOKEN=
# CLICKSIGN_HMAC_SECRET=
FAKE_CONTRACT_WEBHOOK_SECRET=troque-por-openssl-rand-hex-32

# ── E-mail (régua de cobrança) ─────────────────────────
# Vazio = e-mail desligado (os lembretes ficam "não enviado").
# json = não envia, só registra no histórico (bom para demonstração).
# Real: SMTP do seu provedor; na Hostinger, smtp.hostinger.com porta 465 com a caixa criada no hPanel.
SMTP_HOST=json
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Financeiro <financeiro@suaempresa.com.br>

# Primeiro acesso (usados só pelo seed)
SEED_ADMIN_EMAIL=voce@suaempresa.com.br
SEED_ADMIN_PASSWORD=troque-esta-senha-forte
